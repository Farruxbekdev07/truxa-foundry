# ============================================================================
# Firebase configuration (replace with your own project credentials)
# Copy this file to `.env.local` and fill in the values from
# Firebase console → Project settings → Your apps → SDK setup and configuration
# ============================================================================

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional: URL of a Cloud Function that returns AI suggestions
# (See FIREBASE_MIGRATION.md for the expected request/response contract.)
VITE_AI_SUGGESTIONS_ENDPOINT=
